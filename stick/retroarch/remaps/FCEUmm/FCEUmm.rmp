# NES (FCEUmm), the user's layout (2026-11-15): Cross = A (jump in Mario), Circle = B (run / fire),
#   Triangle = A and Square = B too (instead of FCEUmm's turbo buttons), left stick moves like the D-pad.
#   L1 / R1 are hotkeys in config/FCEUmm/FCEUmm.cfg, so they do nothing in the game.
# Keys: input_player1_btn_<RetroPad button pressed> = <RetroPad button sent to the core>
#   (configuration.c input_remapping_load_file; B=0 Y=1 A=8 X=9, -1 = unmapped)
input_player1_btn_b = "8"
input_player1_btn_a = "0"
input_player1_btn_y = "0"
input_player1_btn_x = "8"
input_player1_btn_l = "-1"
input_player1_btn_r = "-1"
# 1 = ANALOG_DPAD_LSTICK
input_player1_analog_dpad_mode = "1"
# Players 2 to 4 (more pads, PlayStation Multitap): the same layout as player 1
input_player2_btn_b = "8"
input_player2_btn_a = "0"
input_player2_btn_y = "0"
input_player2_btn_x = "8"
input_player2_btn_l = "-1"
input_player2_btn_r = "-1"
input_player2_analog_dpad_mode = "1"
input_player3_btn_b = "8"
input_player3_btn_a = "0"
input_player3_btn_y = "0"
input_player3_btn_x = "8"
input_player3_btn_l = "-1"
input_player3_btn_r = "-1"
input_player3_analog_dpad_mode = "1"
input_player4_btn_b = "8"
input_player4_btn_a = "0"
input_player4_btn_y = "0"
input_player4_btn_x = "8"
input_player4_btn_l = "-1"
input_player4_btn_r = "-1"
input_player4_analog_dpad_mode = "1"
