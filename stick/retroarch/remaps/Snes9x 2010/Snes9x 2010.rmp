# Super Nintendo (Snes9x 2010), 2026-11-08: the DualSense's face buttons sit where the SNES pad's do
# (Cross = B, Circle = A, Square = Y, Triangle = X), L1 / R1 = L / R. Only the left stick is added, as the D-pad.
#   L2 / R2 are hotkeys in config/Snes9x 2010/Snes9x 2010.cfg, so they do nothing in the game.
input_player1_btn_l2 = "-1"
input_player1_btn_r2 = "-1"
# 1 = ANALOG_DPAD_LSTICK
input_player1_analog_dpad_mode = "1"
# Player 2 (a second DualSense): same layout
input_player2_btn_l2 = "-1"
input_player2_btn_r2 = "-1"
input_player2_analog_dpad_mode = "1"
