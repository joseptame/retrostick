<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="InfoColumn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="InfoKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:textSize">8.5sp</item>
    </style>

    <style name="InfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
