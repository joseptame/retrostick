<?xml version="1.0" encoding="utf-8"?>
<!-- .plat in inicio.html; MainActivity switches size and colours for the selected tab (.plat.sel) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="108dp"
    android:layout_height="66dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_tab"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="9dp"
    android:paddingEnd="11dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/tabLogo"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:adjustViewBounds="true"
        android:maxWidth="86dp"
        android:scaleType="fitStart" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tabName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tab_name"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/tabCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tab_count"
        android:textSize="8sp" />
</LinearLayout>
