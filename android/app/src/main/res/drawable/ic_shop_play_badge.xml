<?xml version="1.0" encoding="utf-8"?>
<!-- Round play button drawn over the trailer thumbnail in the RetroShop ficha -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center" android:width="40dp" android:height="40dp">
        <shape android:shape="oval">
            <solid android:color="#B30D0B1F" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:gravity="center" android:width="18dp" android:height="18dp" android:drawable="@drawable/ic_shop_play_fill" />
</layer-list>
